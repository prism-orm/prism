{
    "name": "prism-orm/prism",
    "description": "Monorepo de Prism, ORM PHP moderne pour les applications métier et l'IA",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "psr/cache": "^3.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "symfony/console": "^7.4 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "infection/infection": "^0.35",
        "phpbench/phpbench": "^1.4",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/maker-bundle": "^1.62",
        "symfony/messenger": "^7.4 || ^8.0",
        "symfony/security-bundle": "^7.4 || ^8.0",
        "symfony/twig-bundle": "^7.4 || ^8.0",
        "symfony/validator": "^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^7.4 || ^8.0"
    },
    "replace": {
        "prism-orm/bundle": "self.version",
        "prism-orm/dbal": "self.version",
        "prism-orm/migrations": "self.version",
        "prism-orm/orm": "self.version",
        "prism-orm/phpstan": "self.version",
        "prism-orm/test-pack": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Prism\\Exception\\": "packages/dbal/exception/",
            "Prism\\Dbal\\": "packages/dbal/src/",
            "Prism\\Orm\\": "packages/orm/src/",
            "Prism\\Migrations\\": "packages/migrations/src/",
            "Prism\\Bundle\\": "packages/bundle/src/",
            "Prism\\PHPStan\\": "packages/phpstan/src/",
            "Prism\\TestPack\\": "packages/test-pack/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Prism\\Dbal\\Tests\\": "packages/dbal/tests/",
            "Prism\\Orm\\Tests\\": "packages/orm/tests/",
            "Prism\\Migrations\\Tests\\": "packages/migrations/tests/",
            "Prism\\Bundle\\Tests\\": "packages/bundle/tests/",
            "Prism\\PHPStan\\Tests\\": "packages/phpstan/tests/",
            "Prism\\TestPack\\Tests\\": "packages/test-pack/tests/",
            "Prism\\Benchmarks\\": "benchmarks/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
