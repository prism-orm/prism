{
    "name": "prism-orm/bench-doctrine",
    "description": "Prism against Doctrine ORM 3: hydration, flush, N+1, worker memory (ADR 0021)",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [{
        "name": "prism",
        "type": "path",
        "url": "../../../packages/*"
    }],
    "require": {
        "php": ">=8.4",
        "doctrine/orm": "^3.4",
        "phpbench/phpbench": "^1.4",
        "prism-orm/orm": "*@dev",
        "symfony/cache": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "PrismVsDoctrine\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
