# Règle RT-11 : niveau max, strict-rules, aucune baseline sur dbal et orm.
# L'extension de Prism s'applique aussi à son propre code (ADR 0011).
includes:
    - packages/phpstan/extension.neon

parameters:
    level: max
    tmpDir: var/phpstan
    paths:
        - packages/dbal/src
        - packages/dbal/exception
        - packages/dbal/tests
        - packages/orm/src
        - packages/orm/tests
        - packages/migrations/src
        - packages/migrations/tests
        - packages/bundle/src
        - packages/bundle/tests
        - packages/phpstan/src
        - packages/phpstan/tests
        - packages/test-pack/src
        - packages/test-pack/tests
        - benchmarks
        - website/tests
    # cas de la suite de l'extension : du code volontairement faux, analysé par RuleTestCase
    excludePaths:
        - packages/phpstan/tests/data
        - packages/phpstan/tests/Fixtures/Initialized
    checkUninitializedProperties: true
    # PHPBench appelle setUp() (BeforeMethods) avant chaque mesure, comme un constructeur
    additionalConstructors:
        - Prism\Benchmarks\HydrationBench::setUp
        - Prism\Benchmarks\FlushBench::setUp
        - Prism\Benchmarks\TenancyBench::setUp
    checkImplicitMixed: true
    reportUnmatchedIgnoredErrors: true
