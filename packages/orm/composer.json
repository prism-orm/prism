{
    "name": "prism-orm/orm",
    "description": "Prism ORM: attribute mapping, unit of work, batch fetching, typed query builder",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/prism-orm/prism",
    "support": {
        "issues": "https://github.com/prism-orm/prism/issues",
        "source": "https://github.com/prism-orm/prism/tree/main/packages/orm",
        "security": "https://github.com/prism-orm/prism/security/policy"
    },
    "require": {
        "php": ">=8.4",
        "prism-orm/dbal": "self.version",
        "psr/cache": "^3.0",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "symfony/console": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Prism\\Orm\\": "src/"
        }
    },
    "minimum-stability": "stable"
}
