{# Panneau Prism du profiler (ADR 0013, RG-07.4) : requêtes, N+1, chargements par lot, flushs. #}
{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block toolbar %}
    {% set status = collector.nPlusOneCount > 0 ? 'red' : '' %}
    {% set icon %}
        {{ source('@Prism/Collector/icon.svg') }}
        <span class="sf-toolbar-value">{{ collector.queryCount }}</span>
        <span class="sf-toolbar-label">Prism</span>
        {% if collector.nPlusOneCount > 0 %}<span class="sf-toolbar-value">N+1 ×{{ collector.nPlusOneCount }}</span>{% endif %}
    {% endset %}
    {% set text %}
        <div class="sf-toolbar-info-piece"><b>Queries</b><span>{{ collector.queryCount }}</span></div>
        <div class="sf-toolbar-info-piece"><b>Query time</b><span>{{ '%0.2f'|format(collector.durationMs) }} ms</span></div>
        <div class="sf-toolbar-info-piece"><b>N+1 detected</b><span class="sf-toolbar-status{{ collector.nPlusOneCount > 0 ? ' sf-toolbar-status-red' }}">{{ collector.nPlusOneCount }}</span></div>
        <div class="sf-toolbar-info-piece"><b>Batch loads</b><span>{{ collector.batchCount }}</span></div>
        <div class="sf-toolbar-info-piece"><b>Flushes</b><span>{{ collector.flushCount }}</span></div>
    {% endset %}
    {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', { link: profiler_url, status: status }) }}
{% endblock %}

{% block menu %}
    <span class="label{{ collector.nPlusOneCount > 0 ? ' label-status-error' }}">
        <span class="icon">{{ source('@Prism/Collector/icon.svg') }}</span>
        <strong>Prism</strong>
        {% if collector.nPlusOneCount > 0 %}<span class="count"><span>N+1 ×{{ collector.nPlusOneCount }}</span></span>{% endif %}
    </span>
{% endblock %}

{% block panel %}
    <h2>Prism</h2>
    <div class="metrics">
        <div class="metric"><span class="value">{{ collector.queryCount }}</span><span class="label">Queries</span></div>
        <div class="metric"><span class="value">{{ '%0.2f'|format(collector.durationMs) }} <span class="unit">ms</span></span><span class="label">Query time</span></div>
        <div class="metric"><span class="value">{{ collector.nPlusOneCount }}</span><span class="label">N+1 detected</span></div>
        <div class="metric"><span class="value">{{ collector.batchCount }}</span><span class="label">Batch loads</span></div>
        <div class="metric"><span class="value">{{ collector.flushCount }}</span><span class="label">Flushes</span></div>
    </div>

    {% for name, connection in collector.connections %}
        <h3>Connection <code>{{ name }}</code></h3>

        {% if connection.nPlusOne is not empty %}
            <div class="alert alert-error">
                <h4>N+1 detected</h4>
                <table>
                    <thead><tr><th>Times</th><th>Origin</th><th>Query</th></tr></thead>
                    <tbody>
                    {% for detection in connection.nPlusOne %}
                        <tr><td>{{ detection.count }}</td><td><code>{{ detection.origin }}</code></td><td><code>{{ detection.sql }}</code></td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        {% if connection.count > connection.queries|length %}
            <div class="empty">{{ connection.queries|length }} of {{ connection.count }} queries recorded: the recording stops at {{ collector.limit }} per request.</div>
        {% endif %}
        {% if connection.queries is empty %}
            <div class="empty"><p>No query.</p></div>
        {% else %}
            <table>
                <thead><tr><th>#</th><th>Time</th><th>Query</th></tr></thead>
                <tbody>
                {% for query in connection.queries %}
                    <tr>
                        <td>{{ loop.index }}</td>
                        <td class="nowrap">{{ '%0.2f'|format(query.durationMs) }} ms</td>
                        <td><code>{{ query.sql }}</code>{% if query.params is not empty %}<br><small>{{ query.params|json_encode }}</small>{% endif %}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    {% endfor %}

    {% for name, em in collector.entityManagers %}
        <h3>Entity manager <code>{{ name }}</code></h3>

        <h4>Batch loads</h4>
        {% if em.batches is empty %}
            <div class="empty"><p>No batch load.</p></div>
        {% else %}
            <table>
                <thead><tr><th>Loaded</th><th>Entities</th><th>Queries</th></tr></thead>
                <tbody>
                {% for batch in em.batches %}
                    <tr>
                        <td><code>{{ batch.class }}{% if batch.association %}::${{ batch.association }}{% endif %}</code></td>
                        <td>{{ batch.count }}</td>
                        <td>1 instead of {{ batch.count }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}

        <h4>Flushes</h4>
        {% if em.flushes is empty %}
            <div class="empty"><p>No flush.</p></div>
        {% else %}
            {% for flush in em.flushes %}
                <table>
                    <thead><tr><th colspan="3">Flush {{ loop.index }}</th></tr><tr><th>Action</th><th>Entity</th><th>Changes</th></tr></thead>
                    <tbody>
                    {% for change in flush %}
                        <tr>
                            <td>{{ change.action }}</td>
                            <td><code>{{ change.class }}</code>{% if change.id is not empty %} #{{ change.id }}{% endif %}</td>
                            <td>{% for field, values in change.changes %}<code>{{ field }}</code>: {{ values[0] }} → {{ values[1] }}<br>{% endfor %}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% endfor %}
        {% endif %}
    {% endfor %}
{% endblock %}
