{
    "name": "prism-orm/migrations",
    "description": "Versioned migrations and a migration linter for Prism ORM",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/prism-orm/prism",
    "support": {
        "issues": "https://github.com/prism-orm/prism/issues",
        "source": "https://github.com/prism-orm/prism/tree/main/packages/migrations",
        "security": "https://github.com/prism-orm/prism/security/policy"
    },
    "require": {
        "php": ">=8.4",
        "prism-orm/orm": "self.version",
        "symfony/console": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Prism\\Migrations\\": "src/"
        }
    },
    "bin": [
        "bin/prism"
    ],
    "minimum-stability": "stable"
}
